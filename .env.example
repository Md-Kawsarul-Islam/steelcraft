# ==========================================
# Kawsar — Environment Configuration
# ==========================================

# MongoDB
# Local development:
MONGODB_URI=mongodb://127.0.0.1:27017/Kawsar
MONGODB_DB=Kawsar

# Admin authentication
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
ADMIN_SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_32_CHARS_MINIMUM

# Quotation email (Resend)
RESEND_API_KEY=YOUR_RESEND_API_KEY
QUOTE_TO_EMAIL=info@yourdomain.com
RESEND_FROM_EMAIL=Kawsar <noreply@yourdomain.com>

# Public canonical URL used by metadata, sitemap and robots
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
